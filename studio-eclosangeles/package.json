{
  "name": "eclosangeles",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "extract-schema": "sanity schema extract --path=schema.json",
    "typegen": "sanity schema extract --path=schema.json && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate:homepage": "sanity exec scripts/migrateHomePageId.ts --with-user-token",
    "seed": "sanity exec scripts/seedHomePage.ts --with-user-token",
    "seed:vision": "sanity exec scripts/seedVisionStatement.ts --with-user-token",
    "seed:tier1": "sanity exec scripts/seedTier1.ts --with-user-token",
    "seed:programs": "sanity exec scripts/seedHomePagePrograms.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^5.26.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.26.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
