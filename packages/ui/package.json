{
  "name": "@eclosangeles/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React UI components for ECLA. Built against design tokens — never hard-codes colors, spacing, or radii.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eclosangeles/content-schema": "workspace:*",
    "@eclosangeles/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "next-intl": "^3.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next-intl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^15.11.7",
    "next": "^15.1.3",
    "next-intl": "^3.26.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
