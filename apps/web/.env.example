# Sanity CMS connection. These are PUBLIC values (they ship to the browser).
# The app falls back to the committed defaults if these are unset, but in
# production it logs a warning so a misconfigured deploy is easy to spot.
NEXT_PUBLIC_SANITY_PROJECT_ID=b59x306d
NEXT_PUBLIC_SANITY_DATASET=production

# Pin the Sanity API version so query behaviour doesn't drift over time.
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-13
