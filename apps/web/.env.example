# Sanity connection.
#
# The site builds and serves published content without any of these — the values
# below have defaults baked into `lib/sanity/env.ts`. Copy this file to `.env.local`
# only if you need to point at a different project/dataset, or want draft
# previews to work locally.

NEXT_PUBLIC_SANITY_PROJECT_ID=b59x306d
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-13

# Where click-to-edit sends the editor. Use http://localhost:3333 when running
# the Studio locally (`npm run dev` in studio-eclosangeles).
NEXT_PUBLIC_SANITY_STUDIO_URL=https://eclosangeles.sanity.studio

# Required ONLY for draft previews / the Studio's Presentation tool.
# Create a token with Viewer permissions at:
#   https://sanity.io/manage/project/b59x306d/api#tokens
# Keep it out of version control — `.env.local` is gitignored.
SANITY_API_READ_TOKEN=

# Shared secret for the /api/revalidate webhook, which is how published edits
# reach the live site without a redeploy. Invent any long random string, then
# use the identical value in Sanity → API → Webhooks. Without it, the endpoint
# rejects every request and content changes will not go live.
SANITY_REVALIDATE_SECRET=

# Required ONLY for the footer's visit counter, which stores its total on the
# `siteStats` document in Sanity. Create a token with Editor permissions at:
#   https://sanity.io/manage/project/b59x306d/api#tokens
# Without it /api/visits answers 503 and the counter hides itself — nothing
# else on the site needs write access.
SANITY_API_WRITE_TOKEN=
